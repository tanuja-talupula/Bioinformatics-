      "source": [
        "count = {}\n",
        "dna_seq = \"ATGCGTACGTTAGCTAGCTAACGATCGATCGTACGATCGTAGCTAGCTAGGCTAACG\"\n",
        "for i in dna_seq:\n",
        "  if i not in count:\n",
        "    count[i] = 1\n",
        "  else:\n",
        "    count[i] += 1\n",
        "print(count)"
      ]
